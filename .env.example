# Finqit environment configuration
# Copy to .env.local for local development. Never commit real credentials.

# Public Supabase configuration. Keep both empty while using mock/local adapters.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-readable feature flags. All default to false when omitted/blank.
# Accepted values: true, false, 1, 0. Flags control rollout, never authorization.
# Keep REAL_PROVIDERS=false while using mock/sandbox provider adapters.
FINQIT_FEATURE_AI=false
FINQIT_FEATURE_BANKING=false
FINQIT_FEATURE_WHATSAPP=false
FINQIT_FEATURE_MARKETPLACE=false
FINQIT_FEATURE_REAL_PROVIDERS=false
